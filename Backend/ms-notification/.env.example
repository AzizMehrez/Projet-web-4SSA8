# Application Configuration
APP_NAME=ms-notification
APP_ENV=development
APP_PORT=8085
APP_HOST=0.0.0.0
DEBUG=false
ALLOW_TEST_ENDPOINTS=true

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=jobboard.exchange
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_DLX_EXCHANGE=jobboard.dlx
RABBITMQ_DLQ_NAME=notification.dlq
RABBITMQ_CONSUMER_ENABLED=true
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_BACKOFF_SECONDS=5

# SMTP Email Configuration
# Set SMTP_ENABLED=true for real SMTP transmission. When false, emails are safely simulated and logged.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@talentconnect.esprit.tn
SMTP_FROM_NAME=TalentConnect Notification
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Local Storage (Isolated database for processed event IDs & audit logs)
DATABASE_PATH=data/notifications.db

