{% extends 'base.html.twig' %}

{% block title %}Company jobs · JobBoard{% endblock %}

{% block body %}
<h1>Company jobs</h1>
<a class="button" href="{{ path('company_job_new') }}">Create a job</a>
<section class="cards">
    {% for job in jobs %}
        <article>
            <h2>{{ job.title }}</h2>
            <p>{{ job.contractType }} · {{ job.published ? 'Published' : 'Draft' }}</p>
            <b>{{ job.applications|length }} application(s)</b>
            <p class="job-actions">
                <a class="button" href="{{ path('company_job_edit', {id: job.id}) }}">Edit</a>
                <form method="post" action="{{ path('company_job_delete', {id: job.id}) }}" onsubmit="return confirm('Delete this job?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-job' ~ job.id) }}">
                    <button type="submit" class="button button-danger">Delete</button>
                </form>
            </p>
        </article>
    {% else %}
        <p>No jobs yet. Create your first offer.</p>
    {% endfor %}
</section>
{% endblock %}
